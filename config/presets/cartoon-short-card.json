{
  "_comment": "cartoon-short on a dark rounded card, low in the frame. Made for still-picture history Shorts (scripts/still-film.py), whose busy cartoon pictures swallowed outline-only captions. Bottom of the text at 1750 px = 91% of the height: the owner asked twice to push it down because at 79.7% (the Shorts guidebook's rule 25 limit) the card kept covering faces. This deliberately breaks rule 25: on YouTube the title and channel name can overlap the lower line.",
  "canvas": {
    "play_res_x": 1080,
    "play_res_y": 1920
  },
  "font": {
    "family": "Balsamiq Sans",
    "file": "fonts/BalsamiqSans-Bold.ttf",
    "spacing": 0,
    "fudge": 1.0,
    "bold": 1,
    "fontsdir": "fonts",
    "cap_height_px": 50
  },
  "text": {
    "uppercase": false,
    "apostrophe": "’",
    "strip_trailing": ",",
    "word_gap_ratio": 1.6,
    "outline_px": 7,
    "outline_colour": "#2a2521",
    "shadow_px": 3,
    "shadow_colour": "#2a2521"
  },
  "card": {
    "colour": "#1d1a17",
    "alpha": 40,
    "corner_radius_px": 22,
    "pad_x_px": 26,
    "pad_y_px": 12,
    "collision_gap_px": 16,
    "enabled": true
  },
  "layout": {
    "anchor_x": 540,
    "bottom_margin_px": 170,
    "max_line_width_px": 900,
    "max_lines": 2,
    "line_height_px": 84
  },
  "states": {
    "base": {
      "colour": "#FFFFFF"
    },
    "active": {
      "colour": "#FFD84D"
    },
    "spoken": {
      "colour": "#FFFFFF"
    }
  },
  "grouping": {
    "max_words": 4,
    "gap_break_s": 0.4,
    "break_on_sentence_end": true,
    "max_group_duration_s": 3.0
  },
  "timing": {
    "lead_in_ms": 60,
    "hold_out_ms": 250,
    "min_active_ms": 80,
    "min_gap_between_groups_ms": 40,
    "active_extends_to_next_word": true,
    "fade_ms": 80
  },
  "pop": {
    "enabled": true,
    "scale": 110,
    "rise_ms": 70,
    "settle_ms": 110
  }
}