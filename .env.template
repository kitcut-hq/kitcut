# Video Editing Environment Variables
# Copy this to .env and fill in your actual credentials

# ElevenLabs TTS (text-to-speech)
# Get key from https://elevenlabs.io/app/settings/api-keys
# Scoped to TTS only; transcription uses local faster-whisper.
# NOTE: a TTS-scoped key cannot list voices or read the subscription --
# GET /v1/voices and /v1/user/subscription both 401 with missing_permissions
# while synthesis works fine. That is why voice ids are kept by hand in
# config/elevenlabs-voices.json. Only ids marked verified:true there have
# actually been called; two that shipped in that file used to 404.
# Used by scripts/dub-clips.py --tts elevenlabs. Loaded automatically from
# .env by scripts/_env.py -- nothing needs exporting.
ELEVENLABS_API_KEY=sk_xxxxxxxxxxxx

# OpenAI API (for Whisper speech-to-text, GPT calls)
OPENAI_API_KEY=sk-xxxxxxxxxxxx

# YouTube Data API, for scripts/yt-set-chapters.py (writing chapter markers
# into a video description) and scripts/yt-audit-chapters.py.
#
# Do NOT fill these in by hand. Put an OAuth "Desktop app" client JSON at
# .yt-oauth/client_secret.json and run yt-set-chapters.py once: it opens a
# browser, and writes the resulting grant back here.
#
# At the consent screen pick the CHANNEL that owns the videos, not your personal
# account. A personal-account token can read those videos and not edit them,
# which surfaces only as a 403 on the write.
YOUTUBE_CLIENT_ID=xxxxxxxx.apps.googleusercontent.com
YOUTUBE_CLIENT_SECRET=xxxxxxxx
YOUTUBE_REFRESH_TOKEN=xxxxxxxx

# FFmpeg paths (adjust if not in system PATH)
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe

# Output defaults
OUTPUT_QUALITY=1080p
OUTPUT_BITRATE=6000k
OUTPUT_AUDIO_BITRATE=128k
OUTPUT_AUDIO_CODEC=aac
LOUDNESS_TARGET_LUFS=-14.5

# NOTE: the dub pipeline reads no other ELEVENLABS_* variable. Voice ids, the
# model and the voice settings all live in config/elevenlabs-voices.json;
# override per run with dub-clips.py --voice / --el-model.

# Music ducking defaults (sidechain compression)
SIDECHAIN_THRESHOLD=0.035
SIDECHAIN_RATIO=9
SIDECHAIN_ATTACK=12
SIDECHAIN_RELEASE=380
SIDECHAIN_MAKEUP=1

# Temporary file directory
TEMP_DIR=.\temp
