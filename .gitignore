# ---------------------------------------------------------------------------
# Third-party media and anything derived from it.
#
# This repo is the TOOLING only. Source videos, their audio, transcripts and
# rendered outputs are third-party copyrighted content and must never be
# committed -- they are also large enough to wreck the repo.
# ---------------------------------------------------------------------------
sources/*
audio/*
outputs/*
transcripts/*
temp/*
!sources/.gitkeep
!audio/.gitkeep
!outputs/.gitkeep
!transcripts/.gitkeep
!temp/.gitkeep

# Per-video project folders. NEW ones stay local: a project folder is working
# memory for whoever is cutting that video, and the repo is the tooling.
# The 22 folders committed before this line was added remain tracked -- git
# ignores .gitignore for files it already follows -- so their journals and
# manifests still serve as the worked examples the skills and README cite.
# To stop tracking those too: git rm -r --cached projects/
projects/

# Content dirs, listed for the already-tracked folders above (the blanket
# ignore covers new ones): never committed, whatever the folder's status.
projects/*/sources/
projects/*/audio/
projects/*/transcripts/
projects/*/outputs/
projects/*/temp/
projects/*/raws/

# Belt and braces: these must not slip in from anywhere
*.mp4
*.mov
*.mkv
*.avi
*.webm
*.mp3
*.wav
*.m4a
*.flac
*.aac
*.srt
*.vtt
*.ass
*.words.json
*.info.json
*.manifest.json

# Environment / secrets
.env
.env.local
.yt-oauth/

# Python
*.pyc
__pycache__/
.Python
*.egg-info/
dist/
build/
venv/
.venv/
env/

# Working files
*.tmp
*.log
*.swp
*.swo
*~
.DS_Store
Thumbs.db
.cache/
node_modules/

# IDE
.vscode/
.idea/

# Speaker models for auto-switch.py -- 200 MB, downloaded not authored
models/

# Points the tooling at a working directory outside the repo (see
# _env.workspace()). One machine-local path; never shared.
.workspace

# machine-local Claude Code overrides (absolute interpreter path)
.claude/settings.local.json
