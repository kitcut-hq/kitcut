# ---------------------------------------------------------------------------
# Third-party media and anything derived from it.
#
# This repo is the TOOLING only. Source videos, their audio, transcripts and
# rendered outputs are third-party copyrighted content and must never be
# committed -- they are also large enough to wreck the repo.
# ---------------------------------------------------------------------------
sources/*
audio/*
outputs/*
transcripts/*
temp/*
!sources/.gitkeep
!audio/.gitkeep
!outputs/.gitkeep
!transcripts/.gitkeep
!temp/.gitkeep

# Per-video project folders: the metadata and manifests at the top of
# projects/<id>/ are committed; the content dirs inside are not.
projects/*/sources/
projects/*/audio/
projects/*/transcripts/
projects/*/outputs/
projects/*/temp/
projects/*/raws/

# Belt and braces: these must not slip in from anywhere
*.mp4
*.mov
*.mkv
*.avi
*.webm
*.mp3
*.wav
*.m4a
*.flac
*.aac
*.srt
*.vtt
*.ass
*.words.json
*.info.json
*.manifest.json

# Environment / secrets
.env
.env.local
.yt-oauth/

# Python
*.pyc
__pycache__/
.Python
*.egg-info/
dist/
build/
venv/
.venv/
env/

# Working files
*.tmp
*.log
*.swp
*.swo
*~
.DS_Store
Thumbs.db
.cache/
node_modules/

# IDE
.vscode/
.idea/

# Speaker models for auto-switch.py -- 200 MB, downloaded not authored
models/

# Points the tooling at a working directory outside the repo (see
# _env.workspace()). One machine-local path; never shared.
.workspace
