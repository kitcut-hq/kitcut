# The studio's server on the Azure VM. Installed by studio/deploy/install.sh, which fills in the
# @...@ paths. Restart=always is the supervisor the laptop never had; Delegate=yes hands the unit's
# cgroup to the server, which gives every step a cgroup of its own with a memory cap
# (studio/procs.py, Job). KillMode=mixed: a stop sends SIGTERM to the server alone, which records
# each film it is making as interrupted (or leaves it finishing for the next server) and kills the
# film's steps itself; whatever is still running after it exits, or after TimeoutStopSec, is
# SIGKILLed. control-group sent the SIGTERM to every step at once, so a step could die first and
# fail its film before the server knew it was stopping.
[Unit]
Description=KitCut studio server (studio/server.py)
After=network-online.target
Wants=network-online.target

[Service]
User=@USER@
Group=@USER@
Environment=STUDIO_HOME=@HOME@
Environment=STUDIO_REPO=@REPO@
Environment=STUDIO_ENV_FILE=@REPO@/.env
Environment=TZ=America/Los_Angeles
Environment=PYTHONUNBUFFERED=1
# the Whisper models, on the data disk beside the checkout (setup-linux.sh put them there)
Environment=HF_HOME=@REPO@/../hf
# Claude Code's native install (~/.local/bin/claude), for films on the machine's login
Environment=PATH=/home/@USER@/.local/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=@REPO@/studio/deploy/run-server.sh
ExecStartPost=@REPO@/studio/deploy/announce.sh up
ExecStopPost=@REPO@/studio/deploy/announce.sh off
Restart=always
RestartSec=5
Delegate=yes
KillMode=mixed
TimeoutStopSec=60
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target
