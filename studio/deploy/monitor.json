{
  "_doc": "The studio machine's watch (studio/deploy/monitor.py). Every threshold is a starting point measured against kc-local on 2026-10-26 (32 GB, 20 threads, one 1 TB NVMe, RTX 3070): idle it holds ~16 GB with Elasticsearch and Postgres, a busy film day dips well below that. A machine may override any key in STUDIO_HOME/monitor/monitor.local.json.",
  "every_s": 15,
  "port": 8770,
  "page_url": "https://machine.kitcut.ai",
  "history_days": 7,
  "event_keep_s": 1800,
  "mounts": {"root": "/", "boot": "/boot", "efi": "/boot/efi"},
  "disk_device": "nvme0n1",
  "smart_device": "/dev/nvme0",
  "internet_probes": [["1.1.1.1", 443], ["8.8.8.8", 53], ["9.9.9.9", 443]],
  "studio_health": "http://127.0.0.1:8765/api/health",
  "usage_dir": "usage",

  "elasticsearch": {
    "url": "http://127.0.0.1:9200",
    "indices": {"metrics": "machine-metrics", "logs": "machine-logs", "events": "machine-events"},
    "keep_days": {"metrics": 30, "logs": 30, "events": 365},
    "flush_s": 30,
    "buffer_max": 20000
  },

  "_units": "watch: told when one of these is not running for `for_s`. The studio and its tunnel are left out on purpose: the site already tells when the studio stops answering (sketch-studio lib/studiowatch.js), and two emails for one fault teach you to ignore both. They are still on the page. A watched unit that is not enabled (started by hand, like Postgres here on 2026-10-26) is shown but not told.",
  "units": {
    "watch": ["elasticsearch", "mongod-kc", "kitcut-ssh-tunnel", "kitcut-usage",
              "kitcut-claude-rc", "kitcut-monitor-tunnel", "duet-logs-tunnel", "instafill-detector-tunnel",
              "instafill-detector.socket", "ssh", "cron", "systemd-timesyncd"],
    "page_only": ["kitcut-tunnel", "kitcut-studio@*", "postgresql@17-main", "kitcut-autoship.path", "kitcut-backup.timer",
                  "kitcut-backup-full.timer", "kitcut-filmgit.timer", "kitcut-prune.timer",
                  "kitcut-login-check.timer", "nvidia-persistenced", "thermald", "ufw"],
    "last_run": ["kitcut-prune", "kitcut-filmgit"],
    "failed_tell": ["kitcut-*", "instafill-*", "elasticsearch*", "mongod*", "postgresql*", "duet-*",
                    "cloudflared*", "ssh*", "systemd-*"],
    "for_s": 180
  },

  "rules": {
    "memory":      {"warn_below_pct": 10, "crit_below_pct": 5, "clear_above_pct": 15, "for_s": 120},
    "mem_stall":   {"warn_above": 10, "clear_below": 3, "for_s": 120,
                    "_doc": "PSI memory 'full' avg60, %: every task stalled on memory -- thrashing"},
    "swap":        {"warn_above_pct": 80, "clear_below_pct": 60, "for_s": 300},
    "cpu_stall":   {"warn_above": 90, "clear_below": 60, "for_s": 3600,
                    "_doc": "PSI cpu 'some' avg300, %: something has waited for a CPU nearly all the time for an hour"},
    "disk":        {"warn_above_pct": 90, "crit_above_pct": 95, "clear_below_pct": 88,
                    "_doc": "the site already tells at 80 %; this is the second, louder step"},
    "disk_trend":  {"warn_hours": 72, "min_history_h": 6, "window_h": 24},
    "boot_disk":   {"warn_above_pct": 85},
    "inodes":      {"warn_above_pct": 85},
    "cpu_temp":    {"warn_above_c": 95, "clear_below_c": 85, "for_s": 180},
    "nvme_temp":   {"warn_above_c": 75, "clear_below_c": 68, "for_s": 300},
    "gpu_temp":    {"warn_above_c": 87, "clear_below_c": 78, "for_s": 180},
    "nvme_wear":   {"warn_used_pct": 80},
    "es_heap":     {"warn_above_pct": 92, "clear_below_pct": 80, "for_s": 600},
    "es_ship":     {"warn_after_s": 1800},
    "clock":       {"for_s": 1800},
    "internet":    {"down_after_s": 60, "tell_after_s": 120}
  },

  "_journal": "kernel and systemd lines that mean something is wrong. `tell`: emailed (as one event per kind per 10 minutes); otherwise only on the page and in Elasticsearch.",
  "journal": [
    {"kind": "oom_global", "level": "crit", "tell": true,  "re": "oom-kill:constraint=CONSTRAINT_NONE.*?task=([^,]+),pid=(\\d+)",
     "subject": "kc-local ran out of memory and the kernel killed {1}"},
    {"kind": "oom_capped", "level": "warn", "tell": true,  "re": "oom-kill:constraint=CONSTRAINT_MEMCG.*?oom_memcg=([^,]+).*?task=([^,]+),pid=(\\d+)",
     "subject": "A job hit its memory cap and {2} was killed ({1})"},
    {"kind": "disk_error", "level": "crit", "tell": true,  "re": "(I/O error|EXT4-fs error|Buffer I/O error|blk_update_request|nvme\\S*: .*(timeout|reset controller|failed))",
     "subject": "The disk reported an error: {1}"},
    {"kind": "hardware",   "level": "crit", "tell": true,  "re": "(\\[Hardware Error\\]|Machine check events logged|AER: .*Uncorrected)",
     "subject": "The hardware reported an error: {1}"},
    {"kind": "gpu_xid",    "level": "warn", "tell": true,  "re": "NVRM: Xid \\(([^)]*)\\): (\\d+)",
     "subject": "The graphics card reported Xid {2}"},
    {"kind": "kernel_bug", "level": "crit", "tell": true,  "re": "(BUG: |Oops|soft lockup|hard LOCKUP|Kernel panic)",
     "subject": "The kernel reported a fault: {1}"},
    {"kind": "hung_task",  "level": "warn", "tell": true,  "re": "task (\\S+) blocked for more than (\\d+) seconds",
     "subject": "{1} was stuck for more than {2} s (disk or memory starved)"},
    {"kind": "throttle",   "level": "warn", "tell": false, "re": "temperature above threshold, cpu clock throttled",
     "subject": "The CPU slowed itself down for heat"},
    {"kind": "aer_fixed",  "level": "info", "tell": false, "re": "AER: Corrected error",
     "subject": "A corrected PCIe error"},
    {"kind": "segfault",   "level": "info", "tell": false, "re": "(\\S+)\\[\\d+\\]: segfault at",
     "subject": "{1} crashed (segfault)"}
  ]
}
