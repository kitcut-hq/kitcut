# The machine, watched (studio/deploy/monitor.py): every 15 s its CPU, memory, pressure, disks and
# their health, temperatures, GPU, network, services, reboots and the journal's alarms, sent to
# Elasticsearch (machine-* indices), shown on the page (127.0.0.1:8770, published as
# machine.kitcut.ai by kitcut-monitor-tunnel) and told to the owner (health.json ->
# machine_note.py -> the site's watch). Installed by install.sh with the @...@ paths filled in;
# enabled by `ops.sh monitor install`.
#
# The system python3 and the stdlib only, capped and niced like the usage sampler, so that it can
# never be the thing it is looking for -- and the last thing the kernel kills when memory runs out,
# because a watch that dies with the machine's worst minute has nothing to say about it.
[Unit]
Description=KitCut machine watch (studio/deploy/monitor.py)
After=network-online.target elasticsearch.service
Wants=network-online.target

[Service]
User=@USER@
Group=@USER@
Environment=STUDIO_HOME=@HOME@
Environment=TZ=America/Los_Angeles
Environment=PYTHONUNBUFFERED=1
ExecStart=/usr/bin/python3 @REPO@/studio/deploy/monitor.py run
Restart=always
RestartSec=10
Nice=5
CPUWeight=20
MemoryHigh=192M
MemoryMax=320M
OOMScoreAdjust=-500

[Install]
WantedBy=multi-user.target
